# Set these variables in your hosting control panel or shell.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://belesbrands.com.ua
COOKIE_SECURE=true
# Optional persistent volume root; stores data/ and uploads/ beneath it.
# BELES_STORAGE_DIR=/beles-storage

# Optional PostgreSQL. If supplied, failures return 503; JSON is never a fallback.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/beles
# DATABASE_CA_PEM=-----BEGIN CERTIFICATE-----...
PG_POOL_MAX=5
# Local isolated tests only; production must verify TLS.
PGSSL_DISABLE=false

# Generate once in a secret manager: 32 random bytes encoded as base64 or 64 hex digits.
# APP_ENCRYPTION_KEY=
SESSION_TTL_MS=28800000
# Set only the documented CIDRs of the actual immediate reverse proxy.
# TRUSTED_PROXY_CIDRS=

MEDIA_DRIVER=volume
MEDIA_BUDGET_BYTES=1000000000
UPLOAD_CONCURRENCY=1
# Linux container includes qpdf/Ghostscript/prlimit. No automatic processing of existing PDFs.
PDF_OPTIMIZE=true
# S3 and compatible VPS object storage; no automatic account/bucket creation.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=beles-media
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://media.example.com
# Set true only after tools/media-copy.cjs --copy verified all existing files.
MEDIA_READ_REMOTE=false

# Requires owner approval of the editorial draft from TZ 17–17.1.
COOPERATION_APPROVED=false
